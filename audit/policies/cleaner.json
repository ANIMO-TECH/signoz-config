{
  "Version": "2012-10-17",
  "Statement": [
    {"Effect":"Allow","Action":["s3:GetBucketVersioning","s3:GetBucketObjectLockConfiguration"],"Resource":"arn:aws:s3:::AUDIT_BUCKET"},
    {"Effect":"Allow","Action":"s3:ListBucketVersions","Resource":"arn:aws:s3:::AUDIT_BUCKET","Condition":{"StringLike":{"s3:prefix":"platform-audit/*"}}},
    {"Effect":"Allow","Action":["s3:GetObjectVersion","s3:GetObjectRetention","s3:GetObjectLegalHold","s3:DeleteObjectVersion"],"Resource":"arn:aws:s3:::AUDIT_BUCKET/platform-audit/*"},
    {"Effect":"Deny","Action":["s3:PutObject","s3:PutObjectRetention","s3:PutObjectLegalHold","s3:DeleteObject","s3:BypassGovernanceRetention","s3:PutBucketVersioning","s3:PutBucketObjectLockConfiguration","s3:DeleteBucket"],"Resource":["arn:aws:s3:::AUDIT_BUCKET","arn:aws:s3:::AUDIT_BUCKET/*"]}
  ]
}
