{
  "Version": "2012-10-17",
  "Statement": [
    {"Effect":"Allow","Action":["s3:GetBucketVersioning","s3:GetBucketObjectLockConfiguration"],"Resource":"arn:aws:s3:::AUDIT_BUCKET"},
    {"Effect":"Allow","Action":["s3:PutObject","s3:PutObjectRetention","s3:GetObject","s3:GetObjectVersion","s3:GetObjectRetention"],"Resource":"arn:aws:s3:::AUDIT_BUCKET/platform-audit/*"},
    {"Effect":"Deny","Action":["s3:DeleteObject","s3:DeleteObjectVersion","s3:BypassGovernanceRetention","s3:PutBucketVersioning","s3:PutBucketObjectLockConfiguration","s3:DeleteBucket"],"Resource":["arn:aws:s3:::AUDIT_BUCKET","arn:aws:s3:::AUDIT_BUCKET/*"]}
  ]
}
