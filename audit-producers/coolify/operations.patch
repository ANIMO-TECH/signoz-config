diff --git a/app/Support/PlatformOperationAudit.php b/app/Support/PlatformOperationAudit.php
new file mode 100644
index 0000000..1c269c4
--- /dev/null
+++ b/app/Support/PlatformOperationAudit.php
@@ -0,0 +1,134 @@
+<?php
+
+namespace App\Support;
+
+use Illuminate\Database\Eloquent\Model;
+use Illuminate\Support\Facades\Event;
+use Illuminate\Support\Str;
+use Livewire\Livewire;
+use Throwable;
+
+/** Bounded, value-free evidence; native auditLog isolates logging failures. */
+final class PlatformOperationAudit
+{
+    private const MODELS = [
+        'Application', 'ApplicationSetting', 'Service', 'ServiceApplication', 'ServiceDatabase',
+        'Server', 'ServerSetting', 'Project', 'ProjectSetting', 'Environment',
+        'EnvironmentVariable', 'SharedEnvironmentVariable', 'ScheduledTask',
+        'ScheduledDatabaseBackup', 'ScheduledVolumeBackup', 'PrivateKey', 'S3Storage',
+        'StandalonePostgresql', 'StandaloneMysql', 'StandaloneMariadb', 'StandaloneMongodb',
+        'StandaloneRedis', 'StandaloneKeydb', 'StandaloneDragonfly', 'StandaloneClickhouse',
+        'User', 'Team', 'PersonalAccessToken', 'GithubApp', 'GitlabApp', 'InstanceSettings',
+    ];
+
+    public static function register(): void
+    {
+        // Livewire verifies the signed snapshot before this hook. Parameters and
+        // component data are never serialized. "returned" is not business success.
+        Livewire::listen('call', function ($component, $method) {
+            try {
+                if (! preg_match('/^[A-Za-z][A-Za-z0-9_]{0,79}$/D', $method)
+                    || in_array($method, ['render', 'checkStatus', 'getListeners', 'poll', 'refresh'], true)) {
+                    return;
+                }
+                $context = self::callContext($component, $method);
+                request()->attributes->set('platform_operation_id', $context['operation_id']);
+                self::write('ui.operation.called', $context + ['outcome' => 'attempted']);
+                return function () use ($context) {
+                    self::write('ui.operation.returned', $context + ['outcome' => 'handler_returned']);
+                    request()->attributes->remove('platform_operation_id');
+                    // No return value: do not change Livewire's method result.
+                };
+            } catch (Throwable) {
+                return;
+            }
+        });
+        foreach (['created', 'updated', 'deleted'] as $verb) {
+            Event::listen('eloquent.'.$verb.': *', function ($event, $models) use ($verb) {
+                try {
+                    $model = $models[0] ?? null;
+                    if (! $model instanceof Model || ! app()->bound('request')
+                        || request()->isMethodSafe() || app()->runningInConsole()) {
+                        return;
+                    }
+                    $context = self::modelContext($model, $verb);
+                    if ($context === null) {
+                        return;
+                    }
+                    // Do not claim a committed change while a transaction can roll back.
+                    $context['outcome'] = $model->getConnection()->transactionLevel() > 0
+                        ? 'transaction_pending' : 'persisted';
+                    self::write('operation.model.'.$verb, $context);
+                } catch (Throwable) {
+                    // Observability must not abort a model save/delete.
+                }
+            });
+        }
+    }
+
+    public static function callContext(object $component, string $method): array
+    {
+        $class = get_class($component);
+        $context = ['operation_id' => (string) Str::uuid(), 'component' => str_replace('\\', '.', $class), 'operation' => $method];
+        foreach (get_object_vars($component) as $value) {
+            if ($value instanceof Model && ($resource = self::modelContext($value, 'inspect')) !== null) {
+                $context += array_intersect_key($resource, array_flip(['resource_type', 'resource_id']));
+                break;
+            }
+        }
+        return $context;
+    }
+
+    public static function modelContext(Model $model, string $verb): ?array
+    {
+        $type = class_basename($model);
+        if (! in_array($type, self::MODELS, true)) {
+            return null;
+        }
+        $attributes = $model->getAttributes();
+        $id = $attributes['uuid'] ?? $attributes['id'] ?? null;
+        $changed = array_keys($model->getChanges());
+        $changed = array_values(array_filter($changed, fn ($key) => $key !== 'updated_at' && preg_match('/^[a-zA-Z0-9_]{1,80}$/D', $key)));
+        if ($verb === 'updated' && $changed === []) {
+            return null;
+        }
+        return [
+            'resource_type' => $type,
+            'resource_id' => is_scalar($id) && preg_match('/^[a-zA-Z0-9_-]{1,128}$/D', (string) $id) ? (string) $id : null,
+            'changed_fields' => array_slice($changed, 0, 64),
+        ];
+    }
+
+    public static function deployment(object $application, object $deployment, string $outcome): void
+    {
+        try {
+            $app = $application->getAttributes();
+            $run = $deployment->getAttributes();
+            $repository = $app['git_repository'] ?? '';
+            // Canonical GitHub repository only; URLs can contain credentials.
+            preg_match('~^(?:https://github[.]com/|git@github[.]com:)?([A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}?)(?:[.]git)?$~D', $repository, $match);
+            self::write('operation.deployment.'.$outcome, [
+                'application_uuid' => $app['uuid'] ?? null,
+                'deployment_uuid' => $run['deployment_uuid'] ?? null,
+                'repository' => $match[1] ?? null,
+                'commit' => preg_match('/^[a-f0-9]{40}$/D', (string) ($run['commit'] ?? '')) ? $run['commit'] : null,
+                'pull_request_id' => (int) ($run['pull_request_id'] ?? 0),
+                'outcome' => $outcome,
+            ]);
+        } catch (Throwable) {
+        }
+    }
+
+    public static function write(string $event, array $context): void
+    {
+        try {
+            // Use the socket peer, not user-controlled forwarding headers.
+            $peer = app()->bound('request') ? request()->server('REMOTE_ADDR') : null;
+            $context['operation_id'] ??= app()->bound('request') ? request()->attributes->get('platform_operation_id') : null;
+            $context['ip'] = filter_var($peer, FILTER_VALIDATE_IP) ? $peer : null;
+            $context['ip_kind'] = 'socket_peer';
+            auditLog($event, $context);
+        } catch (Throwable) {
+        }
+    }
+}
