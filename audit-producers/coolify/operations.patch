diff --git a/tests/audit/operation.php b/tests/audit/operation.php
new file mode 100644
index 0000000..91d2477
--- /dev/null
+++ b/tests/audit/operation.php
@@ -0,0 +1,74 @@
+<?php
+// Real Laravel/Livewire dependencies, isolated in-memory SQLite, no application boot.
+$events = [];
+$failAudit = false;
+function auditLog($event, $context = [], $level = 'info'): void {
+    global $events, $failAudit;
+    if ($failAudit) { throw new RuntimeException('simulated disk failure'); }
+    $events[] = ['event' => $event] + $context;
+}
+require __DIR__.'/../../vendor/autoload.php';
+use App\Support\PlatformOperationAudit as Audit;
+use Illuminate\Support\Facades\Facade;
+use Illuminate\Database\Capsule\Manager as Capsule;
+use Illuminate\Database\Eloquent\Model;
+use Illuminate\Http\Request;
+
+function check($ok, $message): void { if (! $ok) { throw new RuntimeException($message); } }
+$app = new class extends Illuminate\Foundation\Application {
+    public function runningInConsole() { return false; }
+};
+Illuminate\Container\Container::setInstance($app);
+Facade::setFacadeApplication($app);
+$app->instance('request', Request::create('/livewire/update', 'POST', [], [], [], ['REMOTE_ADDR'=>'192.0.2.42', 'HTTP_X_FORWARDED_FOR'=>'198.51.100.1']));
+$bus = new Livewire\EventBus;
+$app->instance(Livewire\EventBus::class, $bus);
+$app->instance('livewire', new class($bus) {
+    public function __construct(private $bus) {}
+    public function listen($event, $callback) { $this->bus->on($event, $callback); }
+});
+$dispatcher = new Illuminate\Events\Dispatcher($app);
+$app->instance('events', $dispatcher);
+$capsule = new Capsule($app);
+$capsule->addConnection(['driver'=>'sqlite', 'database'=>':memory:', 'prefix'=>'']);
+$capsule->setEventDispatcher($dispatcher);
+$capsule->bootEloquent();
+$capsule->getConnection()->getSchemaBuilder()->create('servers', function ($table) {
+    $table->increments('id'); $table->string('uuid'); $table->string('name'); $table->timestamps();
+});
+Audit::register();
+// Skip model boot side effects while using its real Eloquent save/delete behavior.
+$server = (new ReflectionClass(App\Models\Server::class))->newInstanceWithoutConstructor();
+$server->setRawAttributes(['uuid'=>'server-1', 'name'=>'secret-server-name']);
+$server->save();
+check(count($events) === 1 && $events[0]['event'] === 'operation.model.created', 'insert hook');
+$server->name = 'changed-secret'; $server->save();
+check(end($events)['changed_fields'] === ['name'], 'changed field names only');
+check(end($events)['outcome'] === 'persisted', 'autocommit outcome');
+$capsule->getConnection()->beginTransaction();
+$server->name = 'rolled-back-secret'; $server->save();
+check(end($events)['outcome'] === 'transaction_pending', 'transaction must not claim commit');
+$capsule->getConnection()->rollBack();
+$component = new class($server) { public function __construct(public $server) {} };
+$finish = $bus->trigger('call', $component, 'submit', ['password'=>'never-store']);
+check(end($events)['operation'] === 'submit', 'Livewire action');
+$server->name = 'saved-secret'; $server->save();
+check(end($events)['operation_id'] !== null, 'save associated with operation');
+$value = 'unchanged-return'; $finish($value);
+check($value === 'unchanged-return' && end($events)['outcome'] === 'handler_returned', 'return semantics');
+check(end($events)['ip'] === '192.0.2.42', 'socket peer');
+$server->delete();
+check(end($events)['event'] === 'operation.model.deleted', 'delete hook');
+$appModel = new class { public function getAttributes() { return ['uuid'=>'app-1','git_repository'=>'https://github.com/ANIMO-TECH/jobscheduler.git']; } };
+$run = new class { public function getAttributes() { return ['deployment_uuid'=>'deploy-1','commit'=>str_repeat('a',40),'pull_request_id'=>0]; } };
+Audit::deployment($appModel, $run, 'commit_resolved');
+check(end($events)['repository'] === 'ANIMO-TECH/jobscheduler' && end($events)['commit'] === str_repeat('a',40), 'commit correlation');
+$bad = new class { public function getAttributes() { return ['git_repository'=>'https://token:secret@github.com/ANIMO-TECH/jobscheduler']; } };
+Audit::deployment($bad, $run, 'queued');
+check(end($events)['repository'] === null, 'credential URL stripped');
+check(!str_contains(json_encode($events), 'secret') && !str_contains(json_encode($events), 'password'), 'no values retained');
+$failAudit = true;
+$finish = $bus->trigger('call', $component, 'delete', []);
+$finish($value);
+check($value === 'unchanged-return', 'logging failure isolation');
+echo "Coolify operation integration: 14 checks passed\n";
